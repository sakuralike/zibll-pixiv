msgstr ""
"Project-Id-Version: Zibll Pixiv 0.1.0\n"
"Language: ko_KR\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Pixiv 图片查看器"
msgstr "Pixiv 이미지 뷰어"
msgid "请输入 Pixiv 作品 ID 或链接"
msgstr "Pixiv 작품 ID 또는 링크를 입력하세요"
msgid "无法识别输入，请粘贴 Pixiv 作品链接或纯数字 ID"
msgstr "입력을 인식할 수 없습니다. Pixiv 작품 링크 또는 숫자 ID를 붙여 넣으세요"
msgid "作品不存在、已被删除或限制访问"
msgstr "작품이 없거나 삭제되었거나 접근이 제한되어 있습니다"
msgid "图片代理服务异常，请稍后重试"
msgstr "이미지 프록시 서비스 오류입니다. 나중에 다시 시도하세요"
msgid "服务繁忙，请稍后自动重试"
msgstr "서비스가 혼잡합니다. 잠시 후 다시 시도합니다"
msgid "网络超时，请检查网络后重试"
msgstr "네트워크 시간이 초과되었습니다. 연결을 확인하고 다시 시도하세요"
msgid "未获取到图片"
msgstr "이미지를 가져오지 못했습니다"
msgid "暂时无法获取，请稍后再试或切换代理域名"
msgstr "이미지를 가져올 수 없습니다. 나중에 다시 시도하거나 프록시 도메인을 바꾸세요"
msgid "该作品已被本站屏蔽"
msgstr "이 작품은 사이트에서 차단되었습니다"
msgid "下载原图"
msgstr "원본 다운로드"
msgid "复制直链"
msgstr "직접 링크 복사"
msgid "上一张"
msgstr "이전"
msgid "下一张"
msgstr "다음"
msgid "在 Pixiv 查看原作品"
msgstr "Pixiv에서 원작 보기"
msgid "使用说明与版权提示"
msgstr "사용 안내 및 저작권 고지"
msgid "版权方如需下架，请联系站点管理员。"
msgstr "권리자는 삭제 요청을 위해 사이트 관리자에게 문의할 수 있습니다."
msgid "正在加载图片…"
msgstr "이미지를 불러오는 중…"

msgid "重试"
msgstr "다시 시도"

msgid "已到达最后一张"
msgstr "마지막 페이지입니다"

msgid "已复制"
msgstr "복사됨"

msgid "未生效：屏蔽未启用"
msgstr "비활성: 차단이 꺼져 있습니다"

msgid "未生效：清单为空"
msgstr "비활성: 차단 목록이 비어 있습니다"

msgid "当前生效（%d 条规则）"
msgstr "활성 (%d개 규칙)"

msgid "查看图片"
msgstr "이미지 보기"

msgid "版权方联系入口："
msgstr "저작권자 연락처:"

msgid "提交作品 ID 后将在此处显示图片。"
msgstr "작품 ID를 제출하면 여기에 이미지가 표시됩니다."

msgid "输入 Pixiv 作品 ID 或作品链接，直接在浏览器中预览。"
msgstr "Pixiv 작품 ID 또는 링크를 입력해 브라우저에서 미리 봅니다."

msgid "图片由浏览器直接请求第三方代理服务；该服务可能看到您的 IP 地址。本站不接收、不缓存、不落盘图片内容。"
msgstr "이미지는 브라우저가 제3자 프록시에 직접 요청하며 프록시가 IP 주소를 볼 수 있습니다. 본 사이트는 이미지 내용을 수신, 캐시 또는 저장하지 않습니다."

msgid "已加载 {count} 张，正在加载第 {page} 张…"
msgstr "{count}장 로드됨. {page}번째 이미지를 불러오는 중…"

msgid "已加载 {count} 张，暂时无法确认第 {page} 张是否存在，可重试。"
msgstr "{count}장 로드됨. {page}번째 이미지가 있는지 확인할 수 없습니다. 다시 시도할 수 있습니다."

msgid "已加载 {count} 张，已达到第 {limit} 页安全上限，未继续探测。"
msgstr "{count}장 로드됨. 안전 상한인 {limit}페이지에 도달하여 추가 확인을 중단했습니다."

msgid "第 {page} 张"
msgstr "{page}번째 이미지"
