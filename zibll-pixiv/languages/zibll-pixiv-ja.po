msgid ""
msgstr ""
"Project-Id-Version: Zibll Pixiv 0.1.0\n"
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Pixiv 图片查看器"
msgstr "Pixiv画像ビューア"
msgid "请输入 Pixiv 作品 ID 或链接"
msgstr "Pixiv作品IDまたはリンクを入力してください"
msgid "无法识别输入，请粘贴 Pixiv 作品链接或纯数字 ID"
msgstr "入力を認識できません。Pixiv作品リンクまたは数字のIDを貼り付けてください"
msgid "作品不存在、已被删除或限制访问"
msgstr "作品が存在しないか、削除されたか、アクセスが制限されています"
msgid "图片代理服务异常，请稍后重试"
msgstr "画像プロキシサービスでエラーが発生しました。後でもう一度お試しください"
msgid "服务繁忙，请稍后自动重试"
msgstr "サービスが混雑しています。まもなく再試行します"
msgid "网络超时，请检查网络后重试"
msgstr "ネットワークがタイムアウトしました。接続を確認して再試行してください"
msgid "未获取到图片"
msgstr "画像を取得できませんでした"
msgid "暂时无法获取，请稍后再试或切换代理域名"
msgstr "画像を取得できません。後で再試行するか、プロキシドメインを切り替えてください"
msgid "该作品已被本站屏蔽"
msgstr "この作品はサイトでブロックされています"
msgid "下载原图"
msgstr "元画像をダウンロード"
msgid "复制直链"
msgstr "直リンクをコピー"
msgid "上一张"
msgstr "前へ"
msgid "下一张"
msgstr "次へ"
msgid "在 Pixiv 查看原作品"
msgstr "Pixivで元の作品を見る"
msgid "使用说明与版权提示"
msgstr "利用案内と著作権に関する注意"
msgid "版权方如需下架，请联系站点管理员。"
msgstr "権利者による削除依頼はサイト管理者までご連絡ください。"
msgid "正在加载图片…"
msgstr "画像を読み込んでいます…"

msgid "重试"
msgstr "再試行"

msgid "已到达最后一张"
msgstr "最後のページです"

msgid "已复制"
msgstr "コピーしました"

msgid "未生效：屏蔽未启用"
msgstr "無効: ブロックが無効です"

msgid "未生效：清单为空"
msgstr "無効: ブロックリストが空です"

msgid "当前生效（%d 条规则）"
msgstr "有効（%d 件のルール）"

msgid "查看图片"
msgstr "画像を見る"

msgid "版权方联系入口："
msgstr "権利者への連絡先:"

msgid "提交作品 ID 后将在此处显示图片。"
msgstr "作品IDを送信すると、ここに画像が表示されます。"

msgid "输入 Pixiv 作品 ID 或作品链接，直接在浏览器中预览。"
msgstr "Pixiv作品IDまたはリンクを入力してブラウザでプレビューします。"

msgid "图片由浏览器直接请求第三方代理服务；该服务可能看到您的 IP 地址。本站不接收、不缓存、不落盘图片内容。"
msgstr "画像はブラウザから第三者プロキシへ直接リクエストされ、プロキシにIPアドレスが表示される場合があります。本サイトは画像を受信・キャッシュ・保存しません。"

msgid "已加载 {count} 张，正在加载第 {page} 张…"
msgstr "{count} 枚読み込み済み。{page} 枚目を読み込んでいます…"

msgid "已加载 {count} 张，暂时无法确认第 {page} 张是否存在，可重试。"
msgstr "{count} 枚読み込み済み。{page} 枚目が存在するか確認できません。再試行できます。"

msgid "已加载 {count} 张，已达到第 {limit} 页安全上限，未继续探测。"
msgstr "{count} 枚読み込み済み。安全上限の {limit} ページに達したため、以降の確認を停止しました。"

msgid "第 {page} 张"
msgstr "{page} 枚目"
