msgid "Pixiv 图片查看器"
msgstr "Pixiv Image Viewer"
msgid "请输入 Pixiv 作品 ID 或链接"
msgstr "Enter a Pixiv artwork ID or link"
msgid "无法识别输入，请粘贴 Pixiv 作品链接或纯数字 ID"
msgstr "Input not recognized. Paste a Pixiv artwork link or numeric ID."
msgid "作品不存在、已被删除或限制访问"
msgstr "The artwork does not exist, was deleted, or is unavailable."
msgid "图片代理服务异常，请稍后重试"
msgstr "The image proxy returned an error. Please try again later."
msgid "服务繁忙，请稍后自动重试"
msgstr "The service is busy. Retrying shortly."
msgid "网络超时，请检查网络后重试"
msgstr "The request timed out. Check your network and try again."
msgid "未获取到图片"
msgstr "No image was received."
msgid "暂时无法获取，请稍后再试或切换代理域名"
msgstr "Unable to fetch the image. Try again later or switch proxy domains."
msgid "该作品已被本站屏蔽"
msgstr "This artwork is blocked by this site."
msgid "下载原图"
msgstr "Download original"
msgid "复制直链"
msgstr "Copy direct link"
msgid "上一张"
msgstr "Previous"
msgid "下一张"
msgstr "Next"
msgid "在 Pixiv 查看原作品"
msgstr "View the original artwork on Pixiv"
msgid "使用说明与版权提示"
msgstr "Usage and copyright notice"
msgid "版权方如需下架，请联系站点管理员。"
msgstr "Copyright holders may contact the site administrator to request removal."
msgid "正在加载图片…"
msgstr "Loading image…"

msgid "重试"
msgstr "Retry"

msgid "已到达最后一张"
msgstr "Last page reached"

msgid "已复制"
msgstr "Copied"

msgid "未生效：屏蔽未启用"
msgstr "Inactive: blocking is disabled"

msgid "未生效：清单为空"
msgstr "Inactive: the blocklist is empty"

msgid "当前生效（%d 条规则）"
msgstr "Active (%d rules)"

msgid "查看图片"
msgstr "View image"

msgid "版权方联系入口："
msgstr "Copyright contact:"

msgid "提交作品 ID 后将在此处显示图片。"
msgstr "Submit an artwork ID to display the image here."

msgid "输入 Pixiv 作品 ID 或作品链接，直接在浏览器中预览。"
msgstr "Enter a Pixiv artwork ID or link to preview it in your browser."

msgid "图片由浏览器直接请求第三方代理服务；该服务可能看到您的 IP 地址。本站不接收、不缓存、不落盘图片内容。"
msgstr "Your browser requests the third-party proxy directly; it may see your IP address. This site does not receive, cache, or store image content."
