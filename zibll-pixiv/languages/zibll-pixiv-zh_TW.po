msgid ""
msgstr ""
"Project-Id-Version: Zibll Pixiv 0.1.0\n"
"Language: zh_TW\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Pixiv 图片查看器"
msgstr "Pixiv 圖片檢視器"
msgid "请输入 Pixiv 作品 ID 或链接"
msgstr "請輸入 Pixiv 作品 ID 或連結"
msgid "无法识别输入，请粘贴 Pixiv 作品链接或纯数字 ID"
msgstr "無法識別輸入，請貼上 Pixiv 作品連結或純數字 ID"
msgid "作品不存在、已被删除或限制访问"
msgstr "作品不存在、已被刪除或限制存取"
msgid "图片代理服务异常，请稍后重试"
msgstr "圖片代理服務異常，請稍後再試"
msgid "服务繁忙，请稍后自动重试"
msgstr "服務繁忙，請稍後自動重試"
msgid "网络超时，请检查网络后重试"
msgstr "網路逾時，請檢查網路後再試"
msgid "未获取到图片"
msgstr "未取得圖片"
msgid "暂时无法获取，请稍后再试或切换代理域名"
msgstr "暫時無法取得，請稍後再試或切換代理網域"
msgid "该作品已被本站屏蔽"
msgstr "該作品已被本站封鎖"
msgid "下载原图"
msgstr "下載原圖"
msgid "复制直链"
msgstr "複製直連"
msgid "上一张"
msgstr "上一張"
msgid "下一张"
msgstr "下一張"
msgid "在 Pixiv 查看原作品"
msgstr "在 Pixiv 檢視原作品"
msgid "使用说明与版权提示"
msgstr "使用說明與版權提示"
msgid "版权方如需下架，请联系站点管理员。"
msgstr "版權方如需下架，請聯絡網站管理員。"
msgid "正在加载图片…"
msgstr "正在載入圖片…"

msgid "重试"
msgstr "重試"

msgid "已到达最后一张"
msgstr "已到達最後一張"

msgid "已复制"
msgstr "已複製"

msgid "未生效：屏蔽未启用"
msgstr "未生效：封鎖未啟用"

msgid "未生效：清单为空"
msgstr "未生效：清單為空"

msgid "当前生效（%d 条规则）"
msgstr "目前生效（%d 條規則）"

msgid "查看图片"
msgstr "查看圖片"

msgid "版权方联系入口："
msgstr "版權方聯絡入口："

msgid "提交作品 ID 后将在此处显示图片。"
msgstr "提交作品 ID 後將在此顯示圖片。"

msgid "输入 Pixiv 作品 ID 或作品链接，直接在浏览器中预览。"
msgstr "輸入 Pixiv 作品 ID 或作品連結，直接在瀏覽器中預覽。"

msgid "图片由浏览器直接请求第三方代理服务；该服务可能看到您的 IP 地址。本站不接收、不缓存、不落盘图片内容。"
msgstr "圖片由瀏覽器直接請求第三方代理服務；該服務可能看到您的 IP 位址。本網站不接收、不快取、不儲存圖片內容。"

msgid "已加载 {count} 张，正在加载第 {page} 张…"
msgstr "已載入 {count} 張，正在載入第 {page} 張…"

msgid "已加载 {count} 张，暂时无法确认第 {page} 张是否存在，可重试。"
msgstr "已載入 {count} 張，暫時無法確認第 {page} 張是否存在，可重試。"

msgid "已加载 {count} 张，已达到第 {limit} 页安全上限，未继续探测。"
msgstr "已載入 {count} 張，已達到第 {limit} 頁安全上限，未繼續探測。"

msgid "第 {page} 张"
msgstr "第 {page} 張"
